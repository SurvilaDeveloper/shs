---
// src/layouts/BaseLayout.astro
import "../styles/global.css";
import { BRAND } from "../lib/siteData";
import LogoSHS from "../components/LogoSHS.astro";

const {
  title = BRAND.name,
  description = "Electricidad, plomería, carpintería, herrería y reparaciones generales en Quilmes, Avellaneda, Lanús y AMBA.",
  ogImage = "/og.jpg",
  serviceSchema = null,
} = Astro.props;

const BASE = import.meta.env.BASE_URL;

function withBase(path: string) {
  if (!path) return BASE;
  if (path.startsWith("http")) return path;
  const clean = path.replace(/^\//, "");
  return `${BASE}${clean}`;
}

const siteUrl =
  Astro.site?.toString().replace(/\/$/, "") ??
  `${Astro.url.protocol}//${Astro.url.host}`;

const currentUrl = Astro.url.toString();

const absoluteOgImage = ogImage.startsWith("http")
  ? ogImage
  : `${siteUrl}${withBase(ogImage)}`;

const telHref = `tel:${String(BRAND.phone || "").replace(/\s/g, "")}`;
const whatsappUrl = `https://wa.me/${BRAND.whatsappNumber}`;

const homeUrl = `${siteUrl}${BASE}`;
const serviciosUrl = `${siteUrl}${withBase("/servicios/")}`;

const businessSchema = {
  "@type": "HomeAndConstructionBusiness",
  "@id": `${siteUrl}${BASE}#business`,
  name: BRAND.name,
  url: homeUrl,
  telephone: BRAND.phone,
  image: absoluteOgImage,
  description,
  areaServed: Array.isArray(BRAND.coverage)
    ? BRAND.coverage.map((city: string) => ({
        "@type": "City",
        name: city,
      }))
    : [],
  address: {
    "@type": "PostalAddress",
    addressLocality: BRAND.baseCity,
    addressRegion: "Buenos Aires",
    addressCountry: "AR",
  },
  sameAs: [whatsappUrl],
};

const servicesListSchema = {
  "@type": "ItemList",
  "@id": `${homeUrl}#services`,
  name: `Servicios de ${BRAND.name}`,
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      url: serviciosUrl,
      name: "Electricidad",
    },
    {
      "@type": "ListItem",
      position: 2,
      url: serviciosUrl,
      name: "Plomería",
    },
    {
      "@type": "ListItem",
      position: 3,
      url: serviciosUrl,
      name: "Carpintería",
    },
    {
      "@type": "ListItem",
      position: 4,
      url: serviciosUrl,
      name: "Herrería",
    },
    {
      "@type": "ListItem",
      position: 5,
      url: serviciosUrl,
      name: "Colocación de durlock",
    },
    {
      "@type": "ListItem",
      position: 6,
      url: serviciosUrl,
      name: "Pintura",
    },
    {
      "@type": "ListItem",
      position: 7,
      url: serviciosUrl,
      name: "Reparaciones generales",
    },
  ],
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    businessSchema,
    servicesListSchema,
    ...(serviceSchema ? [serviceSchema] : []),
  ],
};

const NAV_ITEMS = [
  { href: withBase("/"), label: "Inicio" },
  { href: withBase("/servicios/"), label: "Servicios" },
  { href: withBase("/trabajos/"), label: "Trabajos" },
  { href: withBase("/aboutme/"), label: "Acerca de mí" },
  { href: withBase("/contacto/"), label: "Contacto" },
];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={currentUrl} />

    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content="#0f172a" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:image" content={absoluteOgImage} />

    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={BRAND.name} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    />

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-6P36DL1J7D"
    ></script>

    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        dataLayer.push(arguments);
      }

      gtag("js", new Date());
      gtag("config", "G-6P36DL1J7D");
    </script>

    <style>
      summary::-webkit-details-marker {
        display: none;
      }
    </style>
  </head>

  <body class="bg-slate-950 text-slate-100">
    <header
      class="fixed top-0 left-0 right-0 z-50 border-b border-slate-800 bg-black/60 backdrop-blur"
    >
      <div class="mx-auto max-w-6xl px-4">
        <div class="flex h-16 items-center justify-between">
          <a href={withBase("/")} class="flex items-center gap-3">
            <LogoSHS size={38} className="text-slate-100" />

            <div class="leading-tight">
              <p class="text-sm font-extrabold tracking-tight text-slate-100">
                {BRAND.name}
              </p>

              <p class="text-xs text-slate-400">
                {BRAND.coverage.join(" · ")}
              </p>
            </div>
          </a>

          <nav class="hidden md:flex items-center gap-6 text-sm font-semibold">
            {
              NAV_ITEMS.map((item) => (
                <a href={item.href} class="hover:text-white transition">
                  {item.label}
                </a>
              ))
            }
          </nav>

          <details class="relative md:hidden">
            <summary
              class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-700 bg-slate-900/80 text-slate-100 transition hover:bg-slate-800"
            >
              <span class="sr-only">Abrir menú de navegación</span>

              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="h-5 w-5"
                aria-hidden="true"
              >
                <circle cx="12" cy="5" r="2"></circle>
                <circle cx="12" cy="12" r="2"></circle>
                <circle cx="12" cy="19" r="2"></circle>
              </svg>
            </summary>

            <nav
              class="absolute right-0 top-12 min-w-[220px] overflow-hidden rounded-xl border border-slate-800 bg-slate-950 shadow-2xl"
              aria-label="Navegación móvil"
            >
              <ul class="py-2">
                {
                  NAV_ITEMS.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        class="block px-4 py-3 text-sm font-semibold text-slate-200 transition hover:bg-slate-900 hover:text-white"
                      >
                        {item.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </nav>
          </details>
        </div>
      </div>
    </header>

    <main class="pt-16 min-h-[calc(100vh-64px)]">
      <slot />
    </main>

    <footer class="mt-16 border-t border-slate-800 bg-black">
      <div class="mx-auto max-w-6xl px-4 py-10 text-sm text-slate-300">
        <div class="grid gap-6 md:grid-cols-3">
          <div>
            <p class="font-extrabold text-slate-100">{BRAND.name}</p>

            <p class="mt-2">
              Electricidad · Plomería · Carpintería · Herrería · Pintura ·
              Durlock · Reparaciones
            </p>
          </div>

          <div>
            <p class="font-bold text-slate-100">Zonas</p>

            <p class="mt-2">{BRAND.coverage.join(" · ")}</p>
          </div>

          <div>
            <p class="font-bold text-slate-100">Contacto</p>

            <p class="mt-2">Tel: {BRAND.phone}</p>
          </div>
        </div>

        <div class="mt-8 text-xs text-slate-500">
          © {new Date().getFullYear()}
          {BRAND.name}
        </div>
      </div>
    </footer>
  </body>
</html>
