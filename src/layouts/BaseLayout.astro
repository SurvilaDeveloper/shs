---
// src/layouts/BaseLayout.astro
import "../styles/global.css";
import { BRAND } from "../lib/siteData";
import LogoSHS from "../components/LogoSHS.astro";

const {
  title = BRAND.name,
  description = "Electricidad, plomería, carpintería, herrería y reparaciones generales en Quilmes, Avellaneda, Lanús y AMBA.",
  ogImage = "/og.jpg",
} = Astro.props;

// Base URL ("/" en local, "/shs/" en GitHub Pages Project Pages)
const BASE = import.meta.env.BASE_URL; // siempre termina con "/"

function withBase(path: string) {
  if (!path) return BASE;
  if (path.startsWith("http")) return path; // externo

  const clean = path.replace(/^\//, "");
  return `${BASE}${clean}`;
}

const siteUrl =
  Astro.site?.toString().replace(/\/$/, "") ??
  `${Astro.url.protocol}//${Astro.url.host}`;

const currentUrl = Astro.url.toString();

// OG image absoluto, respetando BASE si es una ruta local
const absoluteOgImage = ogImage.startsWith("http")
  ? ogImage
  : `${siteUrl}${withBase(ogImage)}`;

const telHref = `tel:${String(BRAND.phone || "").replace(/\s/g, "")}`;

// JSON-LD Schema (Local Business)
const schema = {
  "@context": "https://schema.org",
  "@type": "HomeAndConstructionBusiness",
  "@id": `${siteUrl}${BASE}#localbusiness`,
  name: BRAND.name,
  url: `${siteUrl}${BASE}`,
  telephone: BRAND.phone,
  areaServed: BRAND.coverage,
  address: {
    "@type": "PostalAddress",
    addressLocality: BRAND.baseCity,
    addressRegion: "Buenos Aires",
    addressCountry: "AR",
  },
};

const NAV_ITEMS = [
  { href: withBase("/"), label: "Inicio" },
  { href: withBase("/servicios/"), label: "Servicios" },
  { href: withBase("/trabajos/"), label: "Trabajos" },
  { href: withBase("/aboutme/"), label: "Acerca de mí" },
  { href: withBase("/contacto/"), label: "Contacto" },
];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <!-- Title & Description -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={currentUrl} />

    <!-- Robots -->
    <meta name="robots" content="index,follow" />

    <!-- Theme -->
    <meta name="theme-color" content="#0f172a" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={BRAND.name} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <!-- Icons (prefijadas por BASE para Project Pages) -->
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="apple-touch-icon" href={withBase("/favicon.svg")} />

    <!-- Structured Data -->
    <script type="application/ld+json">
      {JSON.stringify(schema)}
    </script>

    <style>
      /* Hide default marker for summary (Safari/Chromium) */
      summary::-webkit-details-marker {
        display: none;
      }
    </style>
  </head>

  <body class="bg-slate-950 text-slate-100">
    <!-- HEADER -->
    <header class="fixed top-0 left-0 right-0 z-50 border-b border-slate-800 bg-black/60 backdrop-blur">
      <div class="mx-auto max-w-6xl px-4">
        <div class="flex h-16 items-center justify-between">
          <a href={withBase("/")} class="flex items-center gap-3">
            <LogoSHS size={38} className="text-slate-100" />
            <div class="leading-tight">
              <p class="text-sm font-extrabold tracking-tight text-slate-100">
                {BRAND.name}
              </p>
              <p class="text-xs text-slate-400">
                {BRAND.coverage.join(" · ")}
              </p>
            </div>
          </a>

          <!-- Desktop nav -->
          <nav class="hidden md:flex items-center gap-6 text-sm font-semibold">
            {NAV_ITEMS.map((item) => (
              <a href={item.href} class="hover:text-white transition">
                {item.label}
              </a>
            ))}
          </nav>

          <!-- Mobile menu (⋮) -->
          <details id="mobileNav" class="relative md:hidden">
            <summary
              aria-label="Abrir menú"
              class="list-none rounded-xl border border-slate-700 px-3 py-2 text-slate-100 hover:bg-slate-900 transition cursor-pointer select-none"
            >
              <span class="text-lg leading-none">⋮</span>
            </summary>

            <div class="absolute right-0 mt-2 w-56 overflow-hidden rounded-xl border border-slate-800 bg-slate-950 shadow-lg">
              <nav class="flex flex-col p-2 text-sm font-semibold">
                {NAV_ITEMS.map((item) => (
                  <a
                    href={item.href}
                    data-close-mobile-nav
                    class="rounded-lg px-3 py-2 hover:bg-slate-900 transition"
                  >
                    {item.label}
                  </a>
                ))}

                <div class="my-2 border-t border-slate-800"></div>

                <a
                  href={telHref}
                  data-close-mobile-nav
                  class="rounded-lg px-3 py-2 hover:bg-slate-900 transition"
                >
                  Llamar
                </a>
                <a
                  href={`https://wa.me/${BRAND.whatsappNumber}`}
                  target="_blank"
                  rel="noreferrer"
                  data-close-mobile-nav
                  class="rounded-lg bg-emerald-600 px-3 py-2 font-extrabold text-white hover:bg-emerald-700 transition"
                >
                  WhatsApp
                </a>
              </nav>
            </div>

            <!-- Close when clicking any link inside the menu -->
            <script is:inline>
              (() => {
                const details = document.getElementById("mobileNav");
                if (!details) return;

                const close = () => details.removeAttribute("open");

                // Close on any link click inside the menu
                details.querySelectorAll("[data-close-mobile-nav]").forEach((el) => {
                  el.addEventListener("click", () => close());
                });

                // Close when clicking outside
                document.addEventListener("click", (e) => {
                  if (!details.hasAttribute("open")) return;
                  if (!details.contains(e.target)) close();
                });

                // Close on ESC
                document.addEventListener("keydown", (e) => {
                  if (e.key === "Escape") close();
                });
              })();
            </script>
          </details>

          <!-- Desktop CTA -->
          <div class="hidden md:flex items-center gap-3">
            <a
              href={telHref}
              class="rounded-xl border border-slate-700 px-4 py-2 text-sm font-semibold hover:bg-slate-900 transition"
            >
              Llamar
            </a>
            <a
              href={`https://wa.me/${BRAND.whatsappNumber}`}
              target="_blank"
              rel="noreferrer"
              class="rounded-xl bg-emerald-600 px-4 py-2 text-sm font-extrabold text-white hover:bg-emerald-700 transition"
            >
              WhatsApp
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- MAIN -->
    <main class="pt-16 min-h-[calc(100vh-64px)]">
      <slot />
    </main>

    <!-- FOOTER -->
    <footer class="mt-16 border-t border-slate-800 bg-black">
      <div class="mx-auto max-w-6xl px-4 py-10 text-sm text-slate-300">
        <div class="grid gap-6 md:grid-cols-3">
          <div>
            <p class="font-extrabold text-slate-100">{BRAND.name}</p>
            <p class="mt-2">
              Electricidad · Plomería · Carpintería · Herrería · Pintura · Durlock · Reparaciones
            </p>
          </div>

          <div>
            <p class="font-bold text-slate-100">Zonas</p>
            <p class="mt-2">{BRAND.coverage.join(" · ")}</p>
          </div>

          <div>
            <p class="font-bold text-slate-100">Contacto</p>
            <p class="mt-2">Tel: {BRAND.phone}</p>
            <p class="mt-1">
              <a class="underline hover:text-white" href={withBase("/contacto/")}>
                Ver opciones
              </a>
            </p>
          </div>
        </div>

        <div class="mt-8 text-xs text-slate-500">
          © {new Date().getFullYear()} {BRAND.name}. Todos los derechos reservados.
        </div>
      </div>
    </footer>
  </body>
</html>