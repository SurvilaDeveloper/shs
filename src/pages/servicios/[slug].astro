---
// src/pages/servicios/[slug].astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BRAND, SERVICES } from "../../lib/siteData";
import { CTAWhatsApp } from "../../components/CTAWhatsApp";

export function getStaticPaths() {
    return SERVICES.map((s) => ({
        params: { slug: s.slug },
        props: { service: s },
    }));
}

const { service } = Astro.props;

// Base URL ("/" en local, "/shs/" en GitHub Pages)
const BASE: string = import.meta.env.BASE_URL;
const withBase = (path: string): string => `${BASE}${path.replace(/^\//, "")}`;

const siteUrl =
    Astro.site?.toString().replace(/\/$/, "") ??
    `${Astro.url.protocol}//${Astro.url.host}`;

const pageUrl = Astro.url.toString();

const serviceTitle = String(service?.title ?? "Servicio");
const serviceDescription = String(
    service?.seoDescription ??
        service?.description ??
        "Servicios del hogar en AMBA.",
);

// clases reutilizables
const backLink =
    "text-sm font-semibold text-slate-300 hover:text-white underline underline-offset-4 transition";
const card = "rounded-2xl border border-slate-800 bg-slate-950/40 p-6";
const sideCard = "rounded-2xl border border-slate-800 bg-slate-900/30 p-6";
const secondaryBtn =
    "mt-3 inline-flex w-full items-center justify-center rounded-xl border border-slate-700 bg-slate-950 px-4 py-3 font-bold text-slate-100 hover:bg-slate-900 transition";

// Schema dinámico por servicio
const serviceSchema: Record<string, any> = {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: serviceTitle,
    serviceType: serviceTitle,
    description: serviceDescription,
    url: pageUrl,
    areaServed: Array.isArray(BRAND.coverage)
        ? BRAND.coverage.map((city: string) => ({
              "@type": "City",
              name: city,
          }))
        : [],
    provider: {
        "@type": "HomeAndConstructionBusiness",
        "@id": `${siteUrl}${BASE}#business`,
        name: BRAND.name,
        url: `${siteUrl}${BASE}`,
        telephone: BRAND.phone,
        address: {
            "@type": "PostalAddress",
            addressLocality: BRAND.baseCity,
            addressRegion: "Buenos Aires",
            addressCountry: "AR",
        },
    },
    availableChannel: [
        {
            "@type": "ServiceChannel",
            serviceUrl: pageUrl,
            servicePhone: BRAND.phone,
        },
    ],
    offers: {
        "@type": "Offer",
        availability: "https://schema.org/InStock",
        url: pageUrl,
    },
};

if (Array.isArray(service?.bullets) && service.bullets.length > 0) {
    serviceSchema.hasOfferCatalog = {
        "@type": "OfferCatalog",
        name: `Trabajos de ${serviceTitle}`,
        itemListElement: service.bullets.map(
            (bullet: string, index: number) => ({
                "@type": "Offer",
                itemOffered: {
                    "@type": "Service",
                    name: bullet,
                },
                position: index + 1,
            }),
        ),
    };
}
---

<BaseLayout
    title={service?.seoTitle ?? `${serviceTitle} | ${BRAND.name}`}
    description={serviceDescription}
    serviceSchema={serviceSchema}
>
    <div class="mx-auto max-w-6xl px-4 py-10">
        <a class={backLink} href={withBase("/servicios/")}>
            ← Volver a servicios
        </a>

        <h1 class="mt-4 text-3xl font-extrabold text-slate-100">
            {serviceTitle}
        </h1>

        {
            service?.description ? (
                <p class="mt-3 max-w-2xl text-slate-300">
                    {service.description}
                </p>
            ) : (
                <p class="mt-3 max-w-2xl text-slate-300">
                    Servicio disponible en Zona Sur y AMBA.
                </p>
            )
        }

        <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_0.9fr] lg:items-start">
            <!-- Detalle -->
            <div class={card}>
                <p class="font-extrabold text-slate-100">Trabajos habituales</p>

                <ul class="mt-3 list-disc pl-5 text-slate-300">
                    {(service?.bullets ?? []).map((b: string) => <li>{b}</li>)}
                </ul>
            </div>

            <!-- CTA -->
            <div class={sideCard}>
                <p class="font-extrabold text-slate-100">Presupuesto rápido</p>
                <p class="mt-2 text-sm text-slate-300">
                    Contame tu zona y qué necesitás (si podés, adjuntá una
                    foto).
                </p>

                <div class="mt-4">
                    <CTAWhatsApp
                        client:load
                        label="Escribir por WhatsApp"
                        className="w-full"
                        message={`Hola Gabriel, necesito ${serviceTitle.toLowerCase()}. Estoy en Zona Sur (Quilmes/Avellaneda/Lanús). ¿Me pasás presupuesto?`}
                    />
                </div>

                <a href={withBase("/contacto/")} class={secondaryBtn}>
                    Ver otras opciones de contacto
                </a>

                <p class="mt-4 text-xs text-slate-400">
                    Cobertura: {BRAND.baseCity} · Quilmes · Avellaneda · Lanús · AMBA
                </p>
            </div>
        </div>
    </div>
</BaseLayout>
