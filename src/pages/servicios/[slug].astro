---
// src/pages/servicios/[slug].astro

import BaseLayout from "../../layouts/BaseLayout.astro";
import { BRAND, SERVICES } from "../../lib/siteData";
import { CTAWhatsApp } from "../../components/CTAWhatsApp";

export function getStaticPaths() {
    return SERVICES.map((s) => ({
        params: { slug: s.slug },
        props: { service: s },
    }));
}

const { service } = Astro.props;

const BASE = import.meta.env.BASE_URL;

const withBase = (path: string) => `${BASE}${path.replace(/^\//, "")}`;

const siteUrl =
    Astro.site?.toString().replace(/\/$/, "") ??
    `${Astro.url.protocol}//${Astro.url.host}`;

const pageUrl = Astro.url.toString();

const serviceTitle = String(service?.title ?? "Servicio");

const serviceDescription = String(
    service?.seoDescription ??
        service?.description ??
        "Servicios del hogar en AMBA.",
);

const serviceSchema = {
    "@type": "Service",
    "@id": `${pageUrl}#service`,
    name: serviceTitle,
    serviceType: serviceTitle,
    description: serviceDescription,
    url: pageUrl,

    areaServed: Array.isArray(BRAND.coverage)
        ? BRAND.coverage.map((city: string) => ({
              "@type": "City",
              name: city,
          }))
        : [],

    provider: {
        "@type": "HomeAndConstructionBusiness",
        "@id": `${siteUrl}${BASE}#business`,
        name: BRAND.name,
        url: `${siteUrl}${BASE}`,
        telephone: BRAND.phone,
    },

    offers: {
        "@type": "Offer",
        availability: "https://schema.org/InStock",
        url: pageUrl,
    },
};
---

<BaseLayout
    title={`${serviceTitle} | ${BRAND.name}`}
    description={serviceDescription}
    serviceSchema={serviceSchema}
>
    <div class="mx-auto max-w-6xl px-4 py-10">
        <a
            class="text-sm font-semibold text-slate-300 hover:text-white underline underline-offset-4"
            href={withBase("/servicios/")}
        >
            ← Volver a servicios
        </a>

        <h1 class="mt-4 text-3xl font-extrabold text-slate-100">
            {serviceTitle}
        </h1>

        <p class="mt-3 max-w-2xl text-slate-300">
            {serviceDescription}
        </p>

        <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_0.9fr]">
            <div
                class="rounded-2xl border border-slate-800 bg-slate-950/40 p-6"
            >
                <p class="font-extrabold text-slate-100">Trabajos habituales</p>

                <ul class="mt-3 list-disc pl-5 text-slate-300">
                    {(service?.bullets ?? []).map((b: string) => <li>{b}</li>)}
                </ul>
            </div>

            <div
                class="rounded-2xl border border-slate-800 bg-slate-900/30 p-6"
            >
                <p class="font-extrabold text-slate-100">Presupuesto rápido</p>

                <div class="mt-4">
                    <CTAWhatsApp
                        client:load
                        label="Escribir por WhatsApp"
                        className="w-full"
                        message={`Hola Gabriel, necesito ${serviceTitle.toLowerCase()}.`}
                    />
                </div>
            </div>
        </div>
    </div>
</BaseLayout>
