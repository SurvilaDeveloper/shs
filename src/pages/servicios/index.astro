---
// src/pages/servicios/index.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BRAND, SERVICES } from "../../lib/siteData";

const card =
    "rounded-2xl border border-slate-800 bg-slate-950/40 p-5 hover:bg-slate-950/60 transition";
const linkHint = "text-sm font-semibold text-slate-300";
---

<BaseLayout
    title={`Servicios | ${BRAND.name}`}
    description="Listado de servicios: electricidad, plomería, carpintería, herrería y reparaciones generales. Atención en Quilmes, Avellaneda y Lanús."
>
    <div class="mx-auto max-w-6xl px-4 py-10">
        <h1 class="text-3xl font-extrabold text-slate-100">Servicios</h1>
        <p class="mt-3 text-slate-300 max-w-2xl">
            Elegí el servicio que necesitás. Cada página tiene detalle de
            trabajos habituales y contacto rápido.
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
                SERVICES.map((s) => (
                    <a href={`/servicios/${s.slug}`} class={card}>
                        <p class="text-lg font-extrabold text-slate-100">
                            {s.title}
                        </p>
                        <p class="mt-2 text-sm text-slate-300">{s.short}</p>
                        <p class={`mt-4 ${linkHint}`}>
                            Abrir <span class="text-slate-400">→</span>
                        </p>
                    </a>
                ))
            }
        </div>
    </div>
</BaseLayout>
