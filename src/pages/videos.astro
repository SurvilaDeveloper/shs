---
import BaseLayout from "../layouts/BaseLayout.astro";
import YouTubeVideoCard from "../components/YouTubeVideoCard.astro";
import { BRAND } from "../lib/siteData";
import { VIDEOS, getYouTubeId } from "../lib/videos";

const videos = VIDEOS.map((video) => ({
    video,
    videoId: getYouTubeId(video.url),
}));
---

<BaseLayout
    title={`Videos de trabajos y servicios del hogar | ${BRAND.name}`}
    description="Videos seleccionados de SHS: presentación, demostraciones y trabajos de servicios del hogar en Quilmes, Avellaneda, Lanús y Zona Sur."
>
    <div class="mx-auto max-w-6xl px-4 py-10">
        <header class="max-w-3xl">
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">
                SHS · Servicios del Hogar
            </p>
            <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-slate-100 md:text-4xl">
                Videos
            </h1>
            <p class="mt-3 text-slate-300 leading-relaxed">
                Una selección de videos sobre mi trabajo y los servicios que ofrezco.
                Podés verlos acá mismo o abrir cada uno en YouTube.
            </p>
        </header>

        {videos.length > 0 ? (
            <section class="mt-8 grid gap-5 md:grid-cols-2" aria-label="Galería de videos">
                {videos.map(({ video, videoId }) => (
                    <YouTubeVideoCard video={video} videoId={videoId} />
                ))}
            </section>
        ) : (
            <p class="mt-8 rounded-2xl border border-slate-800 bg-slate-950/40 p-6 text-slate-300">
                Próximamente voy a compartir videos de trabajos y servicios.
            </p>
        )}
    </div>
</BaseLayout>
