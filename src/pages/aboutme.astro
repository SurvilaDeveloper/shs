---
// src/pages/aboutme.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { BRAND, ABOUT_ME, buildWhatsAppLink, SERVICES } from "../lib/siteData";

const whatsappHref = buildWhatsAppLink(ABOUT_ME.whatsappMessage);
const youtubeSrc = `https://www.youtube.com/embed/${ABOUT_ME.youtubeId}`;

// Texto principal (≈ 1200–1400 caracteres)
const aboutBody =
    "En SHS – Servicios del Hogar trabajo con un enfoque simple: resolver problemas de forma prolija, segura y duradera. Atiendo hogares y pequeños comercios en AMBA, con epicentro en Quilmes, Avellaneda y Lanús, y me ocupo personalmente de cada trabajo para que el resultado quede como corresponde.\n\n" +
    "Realizo electricidad, plomería, carpintería, herrería, pintura y reparaciones generales. Desde una revisión de tablero y protecciones, la instalación de iluminación o el cambio de grifería, hasta el ajuste de puertas y herrajes, soldaduras y refuerzos, o mejoras puntuales del hogar. Mi objetivo es que funcione bien, que quede terminado prolijo y que tengas claridad sobre lo que se va a hacer.\n\n" +
    "Sé que cuando algo se rompe o deja de funcionar genera incomodidad. Por eso priorizo explicar el problema con honestidad, acordar el presupuesto antes de comenzar y cuidar tu espacio durante el trabajo. Si necesitás una mano, escribime por WhatsApp con tu zona y una breve descripción (ideal con foto), y coordinamos.";
---

<BaseLayout title={ABOUT_ME.seoTitle} description={ABOUT_ME.seoDescription}>
    <div class="mx-auto max-w-6xl px-4 py-10">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:gap-8">
            {/* Columna izquierda */}
            <div class="min-w-0 flex-1">
                <header>
                    <h1
                        class="text-3xl font-extrabold tracking-tight text-slate-100"
                    >
                        {ABOUT_ME.pageTitle}
                    </h1>

                    <p class="mt-3 max-w-2xl text-slate-300">
                        {ABOUT_ME.intro}
                    </p>
                </header>

                {/* About (texto principal) */}
                <section
                    class="mt-6 rounded-2xl border border-slate-800 bg-slate-950/40 p-5 shadow-sm"
                >
                    <h2 class="text-base font-extrabold text-slate-100">
                        Acerca de mí
                    </h2>

                    <div
                        class="mt-3 space-y-3 text-sm leading-relaxed text-slate-300 whitespace-pre-line"
                    >
                        {aboutBody}
                    </div>

                    {/* Servicios (chips) */}
                    <div class="mt-5 border-t border-slate-800 pt-4">
                        <p
                            class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400"
                        >
                            Servicios que realizo
                        </p>

                        <div class="mt-3 flex flex-wrap gap-2">
                            {
                                SERVICES.map((s) => (
                                    <a
                                        href={`/servicios/${s.slug}`}
                                        class="rounded-full border border-slate-800 bg-slate-900/30 px-3 py-1 text-xs font-semibold text-slate-200 hover:bg-slate-900/50"
                                    >
                                        {s.title}
                                    </a>
                                ))
                            }
                        </div>
                    </div>
                </section>

                {/* Video Card */}
                <section
                    class="mt-6 overflow-hidden rounded-2xl border border-slate-800 bg-slate-950/40 shadow-sm"
                >
                    <div class="border-b border-slate-800 px-4 py-3">
                        <p class="text-sm font-semibold text-slate-200">
                            {ABOUT_ME.videoCardTitle}
                        </p>
                        <p class="mt-1 text-xs text-slate-400">
                            {ABOUT_ME.videoCardSubtitle}
                        </p>
                    </div>

                    <div class="relative w-full" style="aspect-ratio: 16 / 9;">
                        <iframe
                            class="absolute inset-0 h-full w-full"
                            src={youtubeSrc}
                            title={ABOUT_ME.videoTitle}
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                            referrerpolicy="strict-origin-when-cross-origin"
                            allowfullscreen></iframe>
                    </div>
                </section>

                {/* Timeline */}
                <section
                    class="mt-8 rounded-2xl border border-slate-800 bg-slate-950/40 p-5 shadow-sm"
                >
                    <div class="flex items-baseline justify-between gap-4">
                        <h2 class="text-base font-extrabold text-slate-100">
                            {ABOUT_ME.timelineTitle}
                        </h2>
                        <p class="text-xs text-slate-400">
                            {ABOUT_ME.timeline.length} hitos
                        </p>
                    </div>

                    <div class="mt-5 space-y-5">
                        {
                            ABOUT_ME.timeline.map((item, idx) => (
                                <div class="flex gap-4">
                                    <div class="flex flex-col items-center">
                                        <div class="flex h-8 w-8 items-center justify-center rounded-full border border-slate-700 bg-slate-900/60 text-xs font-extrabold text-slate-100">
                                            {idx + 1}
                                        </div>
                                        {idx < ABOUT_ME.timeline.length - 1 ? (
                                            <div class="mt-2 w-px flex-1 bg-slate-800" />
                                        ) : (
                                            <div class="mt-2 w-px flex-1 bg-transparent" />
                                        )}
                                    </div>

                                    <div class="min-w-0 pb-2">
                                        <p class="text-sm font-bold text-slate-100">
                                            {item.title}
                                        </p>
                                        <p class="mt-1 text-sm text-slate-300">
                                            {item.body}
                                        </p>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </section>

                {/* CTAs */}
                <div class="mt-6 flex flex-wrap gap-3">
                    <a
                        href={whatsappHref}
                        class="inline-flex items-center justify-center rounded-xl bg-emerald-500 px-4 py-2 text-sm font-bold text-emerald-950 hover:bg-emerald-400"
                    >
                        {ABOUT_ME.whatsappCtaLabel}
                    </a>

                    <a
                        href={ABOUT_ME.secondaryCtaHref}
                        class="inline-flex items-center justify-center rounded-xl border border-slate-800 bg-slate-950/40 px-4 py-2 text-sm font-semibold text-slate-200 hover:bg-slate-900/40"
                    >
                        {ABOUT_ME.secondaryCtaLabel}
                    </a>
                </div>
            </div>

            {/* Columna derecha */}
            <aside class="w-full shrink-0 lg:w-[340px]">
                <div
                    class="rounded-2xl border border-slate-800 bg-slate-950/40 p-5 shadow-sm"
                >
                    <p class="text-sm font-bold text-slate-100">
                        Datos rápidos
                    </p>

                    <dl class="mt-4 space-y-3 text-sm">
                        <div class="flex items-start justify-between gap-3">
                            <dt class="text-slate-400">Zona</dt>
                            <dd class="text-right text-slate-200">
                                {BRAND.coverage.join(" · ")}
                            </dd>
                        </div>

                        <div class="flex items-start justify-between gap-3">
                            <dt class="text-slate-400">Base</dt>
                            <dd class="text-right text-slate-200">
                                {BRAND.baseCity}
                            </dd>
                        </div>

                        <div class="flex items-start justify-between gap-3">
                            <dt class="text-slate-400">Contacto</dt>
                            <dd class="text-right text-slate-200">
                                {BRAND.phone}
                            </dd>
                        </div>
                    </dl>

                    <div
                        class="mt-5 rounded-xl border border-slate-800 bg-slate-900/30 p-4"
                    >
                        <p
                            class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400"
                        >
                            {ABOUT_ME.tipTitle}
                        </p>
                        <p class="mt-2 text-sm text-slate-200">
                            {ABOUT_ME.tipBody}
                        </p>
                    </div>

                    {/* Mini CTA extra */}
                    <div class="mt-4">
                        <a
                            href={whatsappHref}
                            class="inline-flex w-full items-center justify-center rounded-xl bg-emerald-500 px-4 py-2 text-sm font-extrabold text-emerald-950 hover:bg-emerald-400"
                        >
                            Escribirme por WhatsApp
                        </a>
                    </div>
                </div>
            </aside>
        </div>
    </div>
</BaseLayout>
