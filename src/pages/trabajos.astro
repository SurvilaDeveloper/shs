---
// src/pages/trabajos.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import { BRAND, WORKS } from "../lib/siteData";
import { CTAWhatsApp } from "../components/CTAWhatsApp";
import { ImagesSwiperSites } from "../components/ImagesSwiperSites";
import { SitesImageWithModal } from "../components/SitesImageWithModal";

function toMediaMap(urls: string[]) {
    return Object.fromEntries(
        urls.map((url, idx) => [idx + 1, { id: idx + 1, url }]),
    );
}

function hasModalDesc(w: any) {
    return Boolean((w?.modalDescription ?? "").trim());
}
---

<BaseLayout
    title={`Trabajos realizados | ${BRAND.name}`}
    description="Galería de trabajos realizados: electricidad, plomería, carpintería, herrería y reparaciones del hogar. Zona Sur y AMBA."
>
    <div class="mx-auto max-w-6xl px-4 py-10">
        <h1 class="text-3xl font-extrabold text-slate-100">
            Trabajos realizados
        </h1>

        <p class="mt-3 text-slate-300 max-w-2xl">
            Algunos ejemplos de trabajos. Si querés, contame tu zona y qué
            necesitás (ideal con foto).
        </p>

        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
            {
                WORKS.map((w) => {
                    const gallery = (w.images ?? []).filter(Boolean);
                    const isSwiper = gallery.length >= 2;

                    const title = w.title ?? "Trabajo";
                    const alt = w.alt ?? title;
                    const enableModal = hasModalDesc(w);
                    const modalText = enableModal
                        ? w.modalDescription
                        : undefined;

                    return (
                        <div class="min-w-0 rounded-2xl border border-slate-800 bg-slate-950/40 p-5 shadow-sm">
                            <div class="rounded-xl border border-slate-800 bg-slate-900/30 overflow-hidden">
                                {isSwiper ? (
                                    <div class="w-full">
                                        <ImagesSwiperSites
                                            client:load
                                            mediaMap={toMediaMap(gallery)}
                                            navigation="thumbnails"
                                            fit="width"
                                            enableModal={enableModal}
                                            modalTitle={title}
                                            modalText={modalText}
                                        />
                                    </div>
                                ) : (
                                    <div class="aspect-4/3 overflow-hidden flex items-center justify-center bg-slate-900/30">
                                        {w.image ? (
                                            <SitesImageWithModal
                                                client:load
                                                imageUrl={w.image}
                                                alt={alt}
                                                title={title}
                                                text={modalText}
                                                enableModal={enableModal}
                                                className="h-full w-full object-cover"
                                            />
                                        ) : (
                                            <div class="p-4 text-center">
                                                <p class="text-xs font-bold uppercase tracking-[0.2em] text-slate-400">
                                                    {w.service}
                                                </p>
                                                <p class="mt-2 font-extrabold text-slate-100">
                                                    {w.zone}
                                                </p>
                                            </div>
                                        )}
                                    </div>
                                )}
                            </div>

                            <p class="mt-4 text-base font-extrabold text-slate-100">
                                {title}
                            </p>

                            <p class="mt-1 text-sm text-slate-300">
                                <span class="font-semibold text-slate-200">
                                    {w.service}
                                </span>{" "}
                                · {w.zone}
                            </p>
                        </div>
                    );
                })
            }
        </div>

        <div class="mt-8">
            <CTAWhatsApp
                client:load
                label="Pedir presupuesto"
                className="w-full sm:w-auto"
                message="Hola Gabriel, vi tu sección de trabajos realizados y quería pedir presupuesto. Estoy en Zona Sur (Quilmes/Avellaneda/Lanús)."
            />
        </div>
    </div>
</BaseLayout>
