---
const {
    size = 40,
    className = "",
    label = "SHS - Survila Hogar Servicio",
} = Astro.props;
---

<svg
    width={size}
    height={size}
    viewBox="0 0 64 64"
    role="img"
    aria-label={label}
    class={className}
    xmlns="http://www.w3.org/2000/svg"
>
    <!-- Fondo azul empresarial -->
    <rect width="64" height="64" rx="14" fill="#1e3a8a"></rect>

    <!-- SHS centrado -->
    <text
        x="50%"
        y="52%"
        text-anchor="middle"
        dominant-baseline="middle"
        font-family="Arial, Helvetica, sans-serif"
        font-size="26"
        font-weight="900"
        fill="white"
        letter-spacing="1"
    >
        SHS
    </text>
</svg>
